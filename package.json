{
  "name": "toonlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-driven character animation experiments",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "node scripts/prepare-avatar.mjs && vite",
    "build": "node scripts/prepare-avatar.mjs && vite build",
    "check": "npm test && npm run build && wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test"
  },
  "dependencies": {
    "@met4citizen/talkinghead": "git+https://github.com/met4citizen/TalkingHead.git#2afe6d79779313db8909badebf46f9805a6c7b70",
    "microsoft-cognitiveservices-speech-sdk": "^1.52.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
